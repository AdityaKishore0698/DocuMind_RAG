# LAB SERVER (<lab-host>) local-inference template — copy to local_inference/.env.lab (git-ignored).
# Ollama runs on <lab-host> (existing system service); reached via the SSH tunnel in README.md.
INFERENCE_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11435        # SSH tunnel to the lab server's loopback Ollama
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONNECT_TIMEOUT_S=5
OLLAMA_READ_TIMEOUT_S=300                      # includes cold model load
OLLAMA_KEEP_ALIVE=2m                           # shared GPU: release VRAM soon after use
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false                             # qwen3 reasoning mode off (latency); set true to compare
OLLAMA_EMBEDDING_PREFIXES=true                 # nomic task prefixes search_query:/search_document:
# Must be a local database: nomic vectors are a different embedding space from Gemini's.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/documind_local_ollama
LOCAL_INFERENCE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/documind_local_ollama
