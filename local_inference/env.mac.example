# Template for local_inference/check.py on a machine running Ollama itself — copy to local_inference/.env.mac (git-ignored).
# Ollama runs on this Mac; qwen3:8b because the 14B model needs ~11 GB of the Mac's 16 GB unified memory.
INFERENCE_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434        # the Mac's own Ollama (no tunnel)
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONNECT_TIMEOUT_S=5
OLLAMA_READ_TIMEOUT_S=300                      # includes cold model load
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false
OLLAMA_EMBEDDING_PREFIXES=true
# Isolated local database (port 5436) — never the Gemini evaluation DB (5434) or production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/documind_local_ollama
LOCAL_INFERENCE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/documind_local_ollama
