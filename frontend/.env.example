# Copied to .env.local by `scripts/setup_local_env.sh` with the local Supabase values filled in.
# Base URL of the FastAPI backend, as the browser reaches it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (the local stack started by `supabase start`: http://127.0.0.1:54321).
# The anon/publishable key is printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# "Continue with Google" needs a Google OAuth client configured in Supabase. Off for the local stack.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
