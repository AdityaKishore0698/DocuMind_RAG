# Base URL of the FastAPI backend, reachable from the browser.
# Local dev default is http://localhost:8000 (see lib/config.ts).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase — used for authentication (email + password with email confirmation, Google OAuth).
# Project Settings -> API -> Project URL and the "anon"/publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
