# ResearchLens backend configuration (API + worker) — reference.
#
# For the local quick start you do NOT edit this file: `scripts/setup_local_env.sh` writes `.env.local`
# (read by docker compose) from the running local Supabase stack. This file documents every variable.
# Never commit real credentials; `.env` and `.env.*` (except this file) are git-ignored.

# ─── Database: Postgres + pgvector (local Supabase: port 54322) ──────────────
# Seen from the containers, the host is host.docker.internal.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# ─── Supabase auth + storage (local Supabase: port 54321) ───────────────────
# Tokens are verified with SUPABASE_JWT_SECRET (HS256, local stack) or the project's JWKS (ES256).
# The service-role key lets the API/worker read and write the private `documents` bucket.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=from-supabase-status
SUPABASE_JWT_SECRET=from-supabase-status

# ─── Celery broker (the compose file overrides this with its own Redis) ─────
REDIS_URL=redis://redis:6379/0

# ─── Inference: local Ollama (default route) ────────────────────────────────
INFERENCE_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:8b                 # answers, comparisons, gap analysis, agent planning
OLLAMA_EMBEDDING_MODEL=nomic-embed-text    # 768-d document and query embeddings
# OLLAMA_KEEP_ALIVE=10m                    # how long Ollama keeps the model loaded after a call
# OLLAMA_NUM_CTX=8192                      # context window requested from Ollama
# OLLAMA_READ_TIMEOUT_S=300                # includes model load time on the first call
# OLLAMA_THINK=false                       # qwen3 "thinking" off: faster, no reasoning tokens in answers
# OLLAMA_EMBEDDING_PREFIXES=true           # nomic task prefixes; changing it changes the embedding space

# ─── Optional: Google Gemini instead of Ollama (hosted, needs an API key) ───
# INFERENCE_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# CHAT_MODEL=gemini-3.6-flash
# EMBEDDING_MODEL=gemini-embedding-2
# Switching providers switches the embedding space: existing papers stay unsearchable until re-processed.

# ─── Behaviour (defaults shown) ─────────────────────────────────────────────
# RETRIEVAL_MODE=vector        # or hybrid_bm25 (needs `scripts/migrate.py up 001_bm25_hybrid`)
# RETRIEVAL_HYBRID_TIMEOUT_MS=300
# RETRIEVAL_TOP_K=5            # chunks per answer, 1–20
# AGENT_ENABLED=false          # "Deep analysis" chat mode (bounded LangGraph; ~3 extra model calls)
# AGENT_TIME_BUDGET_S=60
# HELPER_MODEL=                # model for the agent/analysis JSON calls (default: the chat model; Gemini only)
# MAX_UPLOAD_MB=20
# EMBED_BATCH_SIZE=32
# EMBED_ITEMS_PER_MIN=90       # pacing for the Gemini free tier; Ollama is not paced
# EMBED_MAX_RETRIES=4
# LOG_LEVEL=INFO

# ─── CORS: the browser origin(s) of the frontend ────────────────────────────
FRONTEND_ORIGINS=http://localhost:3000
