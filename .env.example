# ─── Database — Supabase (Postgres + pgvector) ───────────────────────────────
# REQUIRED. Read by BOTH the API and the Worker (SQLAlchemy).
# Use the Supabase connection pooler for containers/serverless:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ─── Supabase — Storage + Auth ──────────────────────────────────────────────
# REQUIRED. SUPABASE_URL is read by the API (Storage upload + Auth token
# verification via <url>/auth/v1/.well-known/jwks.json), the Worker (Storage
# download), and the admin account-deletion call.
# SUPABASE_SERVICE_ROLE_KEY: Supabase -> Project Settings -> API. Create a
# private Storage bucket named "documents".
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only needed if the project still uses the legacy shared HS256 JWT secret
# (new projects use asymmetric keys and don't need this).
# SUPABASE_JWT_SECRET=

# ─── Redis broker — Upstash (serverless Redis) ───────────────────────────────
# REQUIRED. Celery broker + result backend. Read by BOTH the API (to enqueue)
# and the Worker (to consume). Upstash endpoints are TLS:
#   rediss://default:<password>@<region>.upstash.io:6379
# Celery over TLS may need the query suffix: ?ssl_cert_reqs=required
REDIS_URL=rediss://default:password@host:6379

# ─── Gemini API (google-genai SDK) ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
CHAT_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-2

# ─── Optional (defaults shown; leave unset in production) ────────────────────
# Retrieval: `vector` (default) or `hybrid_bm25` (vector + full-text BM25 + RRF).
# hybrid_bm25 requires the migration in scripts/migrations/bm25.py — the API
# refuses to start without it. Not yet approved for production.
# RETRIEVAL_MODE=vector
# RETRIEVAL_HYBRID_TIMEOUT_MS=300
# Inference provider: `gemini` (default) or `ollama` (local development only —
# see local_inference/README.md; requires a local DATABASE_URL).
# INFERENCE_PROVIDER=gemini

# ─── Auth ───────────────────────────────────────────────────────────────────
# Handled by Supabase Auth (see SUPABASE_URL above). No secret to set here.

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API — set to your Vercel URL(s).
# "*" is accepted for local development only (credentials are disabled in that mode).
FRONTEND_ORIGINS=https://your-frontend.vercel.app
